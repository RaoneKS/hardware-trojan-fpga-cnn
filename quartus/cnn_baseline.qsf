set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31I7
set_global_assignment -name TOP_LEVEL_ENTITY cnn_fpga_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE cnn_baseline.sdc
set_global_assignment -name VERILOG_INPUT_VERSION SystemVerilog_2005
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name USE_CONFIGURATION_DEVICE OFF

# RTL
set_global_assignment -name VERILOG_FILE ../rtl/cnn_fpga_top.v
set_global_assignment -name VERILOG_FILE ../rtl/cnn_mnist_full_pe.v

# DE10-Standard I/O
set_location_assignment PIN_AF14 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

set_location_assignment PIN_AJ4 -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n

set_location_assignment PIN_AA24 -to result[0]
set_location_assignment PIN_AB23 -to result[1]
set_location_assignment PIN_AC23 -to result[2]
set_location_assignment PIN_AD24 -to result[3]
set_location_assignment PIN_AG25 -to valid_out
set_location_assignment PIN_AF25 -to led

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to result[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to result[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to result[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to result[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to valid_out
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n
